<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
    <groupId>org.goplanit.parentpom</groupId>
    <artifactId>planit-parentpom</artifactId>
		<version>0.5.b1</version>
	</parent>

	<groupId>org.goplanit.xml</groupId>
	<artifactId>planit-xmlgenerator</artifactId>
	<description>Generate XML java files from xsd schemas to be used by PLANitIO to convert XML based inputs into
		PLANit memory model. This is a separate project to ensure that only when the xsd schemas change a
		recompilation of the generated XMLs is required.
		Conversely, whenever business logic in PLANitIO changes no update of the generated classes will be necessary.
	</description>
	<packaging>jar</packaging>

	<name>planit-xmlgenerator</name>
	<url>https://github.com/TrafficPLANit/PLANitXMLGenerator</url>

	<!-- license based on the one published on the website -->
	<licenses>
		<license>
			<name>PLANit license based on modified BSD</name>
			<url>${planit.website.url}/docs/licenses/LICENSE.txt</url>
			<distribution>repo</distribution>
			<comments>A slightly modified version of a modified BSD license</comments>
		</license>
	</licenses>

	<dependencies>

		<!-- some generated files have gml dependencies -->
		<dependency>
			<groupId>net.opengis.schemas</groupId>
			<artifactId>gml-3.1</artifactId>
			<version>3.1.1-1</version>
		</dependency>

		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
		</dependency>

		<!-- when running in Java versions >11 this is needed explicitly as it is no longer included by default -->
		<dependency>
			<groupId>com.sun.activation</groupId>
			<artifactId>jakarta.activation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
		</dependency>

		<!-- XML versioning wrapping -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
		</dependency>

	</dependencies>

	<build>

		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>examples</exclude>
				</excludes>
			</resource>
		</resources>

		<plugins>
			<plugin>

				<!-- make sure dirs exist so they can be marked as source dirs later for IDE -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>create-generated-dirs</id>
						<phase>initialize</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<mkdir dir="${project.build.directory}/generated-sources/xjc-v1" />
								<mkdir dir="${project.build.directory}/generated-sources/xjc-v2" />
								<mkdir dir="${project.build.directory}/generated-sources/xjc-gml" />
								<mkdir dir="${project.build.directory}/generated-sources/annotations" />
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- generate JAXB XML generated classes in versioned way and pulling in GML -->
			<plugin>
				<groupId>org.jvnet.jaxb</groupId>
				<artifactId>jaxb-maven-plugin</artifactId>
				<version>4.0.12</version>
				<configuration>
					<extension>true</extension>
					<args>
						<arg>-XautoNameResolution</arg>
					</args>
				</configuration>

				<executions>
						<execution>
							<id>phase1-ogc-remote</id>
							<goals>
								<goal>generate</goal>
							</goals>
							<configuration>
								<schemas>
									<schema>
										<url>http://schemas.opengis.net/gml/3.1.1/base/gml.xsd</url>
									</schema>
								</schemas>
								<bindingDirectory>src/main/resources/xjb/shared</bindingDirectory>
								<generatePackage>net.opengis.gml</generatePackage>
								<episode>true</episode>
								<generateDirectory>${project.build.directory}/generated-sources/xjc-gml</generateDirectory>
								<args>
									<arg>-XautoNameResolution</arg>
								</args>
							</configuration>
					</execution>

					<execution>
						<id>generate-v1</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<schemaDirectory>src/main/resources/xsd/v1</schemaDirectory>
							<bindingDirectory>src/main/resources/xjb</bindingDirectory>
							<bindings>
								<binding>
									<fileset>
										<directory>${project.build.directory}/generated-sources/xjc-gml/META-INF</directory>
										<includes>
											<include>sun-jaxb.episode</include>
										</includes>
									</fileset>
								</binding>
							</bindings>
							<bindingIncludes>
								<include>v1/*.xjb</include>
							</bindingIncludes>
							<generatePackage>org.goplanit.xml.generated.v1</generatePackage>
							<generateDirectory>${project.build.directory}/generated-sources/xjc-v1</generateDirectory>
							<args>
								<arg>-XautoNameResolution</arg>
							</args>
						</configuration>
					</execution>
					<execution>
						<id>generate-v2</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<schemaDirectory>src/main/resources/xsd/v2</schemaDirectory>
							<bindingDirectory>src/main/resources/xjb</bindingDirectory>
							<bindings>
								<binding>
									<fileset>
										<directory>${project.build.directory}/generated-sources/xjc-gml/META-INF</directory>
										<includes>
											<include>sun-jaxb.episode</include>
										</includes>
									</fileset>
								</binding>
							</bindings>
							<bindingIncludes>
								<include>v2/*.xjb</include>
							</bindingIncludes>
							<generatePackage>org.goplanit.xml.generated.v2</generatePackage>
							<generateDirectory>${project.build.directory}/generated-sources/xjc-v2</generateDirectory>
							<args>
								<arg>-XautoNameResolution</arg>
							</args>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- populate in correct spot -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>add-source</id>
						<phase>process-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/xjc-v1</source>
								<source>${project.build.directory}/generated-sources/xjc-v2</source>
								<source>${project.build.directory}/generated-sources/xjc-gml</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- wrap common versioned classes into version agnostic classes for usage -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>${maven.compiler.java.version}</source>
					<target>${maven.compiler.java.version}</target>
					<annotationProcessorPaths>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${org.mapstruct.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
			</plugin>

		</plugins>
	</build>

	<repositories>
		<!-- PLANit repository to obtain parentpom from-->
		<repository>
			<id>planit-repository.goplanit.org</id>
			<name>PLANit Repository</name>
			<url>https://repository.goplanit.org</url>
		</repository>
	</repositories>

</project>
