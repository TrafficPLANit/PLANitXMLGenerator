<jaxb:bindings version="3.0"
               xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
               xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
               xmlns:xs="http://www.w3.org/2001/XMLSchema"
               jaxb:extensionBindingPrefixes="xjc">
	
	<jaxb:bindings
		schemaLocation="../../xsd/v1/macroscopicintermodalinput.xsd"
		node="//xs:element[@name = 'macroscopicintermodal']">
		<jaxb:class name="XMLElementMacroscopicIntermodal" />
	</jaxb:bindings>
	
  <jaxb:bindings
    schemaLocation="../../xsd/v1/macroscopicintermodalinput.xsd"
    node="//xs:element[@name = 'transferzoneaccess']">
    <jaxb:class name="XMLElementTransferZoneAccess" />
  </jaxb:bindings>  	
	
	<jaxb:bindings
		schemaLocation="../../xsd/v1/macroscopicintermodalinput.xsd"
    node="//xs:element[@name = 'transferzoneaccess']/xs:complexType/xs:sequence/xs:element[@name = 'connectoid']/xs:complexType">
		<jaxb:class name="XMLElementTransferConnectoid" />
	</jaxb:bindings>
	
	<jaxb:bindings
		schemaLocation="../../xsd/v1/macroscopicintermodalinput.xsd"
		node="//xs:element[@name = 'transfergroup']">
		<jaxb:class name="XMLElementTransferGroup" />
	</jaxb:bindings>
	
	<jaxb:bindings
		schemaLocation="../../xsd/v1/macroscopicintermodalinput.xsd"
		node="//xs:element[@name = 'transferzones']">		
		<jaxb:class name="XMLElementTransferZones" />   
	</jaxb:bindings>		
	
  <jaxb:bindings
    schemaLocation="../../xsd/v1/macroscopicintermodalinput.xsd"
      node="//xs:element[@name = 'transferzones']/xs:complexType/xs:sequence/xs:element[@name = 'zone']/xs:complexType">
      <jaxb:class name="XMLElementTransferZone" />
    </jaxb:bindings> 	
		
	<jaxb:bindings
		schemaLocation="../../xsd/v1/macroscopicintermodalinput.xsd"
		node="//xs:element[@name = 'transferzonegroups']">
		<jaxb:class name="XMLElementTransferZoneGroups" />
	</jaxb:bindings>	
		
</jaxb:bindings>