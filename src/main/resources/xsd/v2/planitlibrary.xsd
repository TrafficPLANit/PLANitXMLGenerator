<?xml version="1.0" encoding="UTF-8" ?>
<!-- This XSD contains common definitions which are used by all the other XSD files -->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:gml="http://www.opengis.net/gml"
		   targetNamespace="http://goplanit.org/v2"
		   xmlns="http://goplanit.org/v2"
		   elementFormDefault="qualified">
	<xs:import namespace="http://www.opengis.net/gml" schemaLocation="http://schemas.opengis.net/gml/3.1.1/base/gml.xsd" />

	<xs:simpleType name="connectoidnodelocationtype">
		<xs:annotation>
			<xs:documentation>
				the chosen node location is downstream for transfer connectoids that reference a link segment
				however, in case all routes start on the upstream end of a link segment that has NO other incoming
				regular link segments we cannot identify this node properly. Only in this special case, use this location
				type to indicate that the upstream node of the reference link segment is the point of access for commencing
				pt lines.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="upstream" />
			<xs:enumeration value="downstream" />
		</xs:restriction>
	</xs:simpleType>

	<!-- COMPLEX TYPES -->
	<xs:complexType name="customPropertiesType">
		<xs:sequence>
			<xs:element name="entryElement" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
						Each entry is a single custom property with a key as its identifier and the content
						representing the value
					</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string"> <!-- contains the value content -->
							<xs:attribute name="keyAttribute" type="xs:string" use="required"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="connectoidtype">
		<xs:annotation>
			<xs:documentation>
				Length can be used to override geometric length computed for connectoid based on zone and physical
				network (layer) connection.
				When multiple zones are accessible each one gets its own access zone element
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<!-- zero or more access zone elements as for OD connectoid we currently have inverted this setup
			 and do not use this, but for transfer zones it is mandatory to have at least one-->
			<xs:element name="accesszone" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:attribute name="ref" type="xs:string" use="required"/>
					<xs:attribute name="lengthkm" type="xs:decimal" use="optional"/>
					<xs:attribute name="lsrefs" type="xs:string" use="optional">
						<xs:annotation>
							<xs:documentation>
								when absent all mode supporting entry link segments into the node are allowed, otherwise
								use this subset
							</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="modes" type="xs:string" use="optional"/>
					<xs:attribute name="type" type="connectoidtypetype" use="optional" default="none">
						<xs:annotation>
							<xs:documentation>
								Use type to provide additional information on how to interpret this connectoid
								(no functional use at this point)
							</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="id" type="xs:string" use="required"/>
		<xs:attribute name="externalid" type="xs:string" use="optional"/>
		<xs:attribute name="name" type="xs:string" use="optional"/>
		<xs:attribute name="noderef" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>
					Reference to the node that acts as the access point for the zone.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- SIMPLE TYPES -->
	
  <xs:simpleType name="direction">
    <xs:annotation>
      <xs:documentation>
        Choice between direction from a->b, or b->a
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="a_b" />
      <xs:enumeration value="b_a" />
    </xs:restriction>
  </xs:simpleType>	
	
	<xs:simpleType name="connectoidtypetype">
    <xs:annotation>
      <xs:documentation>
        types of connectoid types
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
		<xs:enumeration value="none" />
		<xs:enumeration value="access_egress" />
		<xs:enumeration value="pt_veh_stop" />
		<xs:enumeration value="access" />
		<xs:enumeration value="egress" />
		<xs:enumeration value="unknown" />
    </xs:restriction>
  </xs:simpleType>  
	
	<xs:simpleType name="lengthUnit">
		<xs:annotation>
			<xs:documentation>
				Choice between km (kilometres), m (metres)
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="km" />
			<xs:enumeration value="m" />
		</xs:restriction>
	</xs:simpleType>
	
	<xs:simpleType name="timeUnit">
		<xs:annotation>
			<xs:documentation>
				Choice between h (hours), min (minutes), s (seconds), ms (milliseconds)
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="h" />
			<xs:enumeration value="min" />
			<xs:enumeration value="s" />
			<xs:enumeration value="ms" />
		</xs:restriction>
	</xs:simpleType>		
	
	<xs:simpleType name="srsname">	
		<xs:restriction base="xs:string">
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="septype" >
		<xs:annotation>
			<xs:documentation>
				Destination separator, i.e., the separator after the end of each cell.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<!-- ELEMENTS -->
	
	<xs:element name="centroid">
		<xs:annotation>
			<xs:documentation>
				Centroid is a point of departure and/or arrival of travellers from/to a zone. 
			</xs:documentation>
		</xs:annotation>	
		<xs:complexType>
			<xs:sequence>
				<xs:element name="name" type="xs:string" minOccurs="0" />
				<xs:element ref="gml:Point" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation>
							Each centroids geospatial location determines its location (point of departure/arrival).
							It should fall within the zones
							geospatial area (if defined).
						</xs:documentation>
					</xs:annotation>				
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<!-- simple elements -->

	<!-- Complex types -->
	<xs:complexType name="unrestrictedduration">
		<xs:annotation>
			<xs:documentation>
				Duration give as a positive integer in some unit in
				unrestricted from (no limitation on choice of integer)
			</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="xs:positiveInteger">
				<xs:attribute name="unit" type="durationunit" 	default="s" use="optional">
					<xs:annotation>
						<xs:documentation>
							Default duration unit is assumed to be seconds
							(s)
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<!-- Simple types -->
	<xs:simpleType name="durationunit">
		<xs:annotation>
			<xs:documentation>
				Choice between h (hours), m (minutes), s (seconds)
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="h" />
			<xs:enumeration value="m" />
			<xs:enumeration value="s" />
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="duration">
		<xs:annotation>
			<xs:documentation>
				Duration is a positive integer (in seconds) and we
				start counting from the start time. Note that the duration must
				always be less
				than the number of seconds in a day (86400).
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:restriction base="unrestrictedduration">
					<xs:minInclusive value="1" />
					<xs:maxInclusive value="86400" />
				</xs:restriction>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="starttime" type="xs:time"
				default="00:00:00">
		<xs:annotation>
			<xs:documentation>
				Start time is given in 24-hour format like the
				following 'hh:mm:ss'
			</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:complexType name="TimePeriodType">
		<xs:sequence>
			<xs:element name="name" type="xs:string" minOccurs="0" maxOccurs="1" />
			<xs:element ref="starttime" minOccurs="0" />
			<xs:element ref="duration" />
		</xs:sequence>
		<xs:attribute name="id" type="xs:string" use="required" />
		<xs:attribute name="externalid" type="xs:string" use="optional"/>
	</xs:complexType>

	<xs:complexType name="TimePeriodsContainerType">
		<xs:sequence>
			<xs:element name="timeperiod" type="TimePeriodType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	
</xs:schema>