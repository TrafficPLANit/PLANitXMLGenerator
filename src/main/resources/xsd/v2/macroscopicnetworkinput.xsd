<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:gml="http://www.opengis.net/gml"
		   targetNamespace="http://goplanit.org/v2"
		   xmlns="http://goplanit.org/v2"
		   elementFormDefault="qualified">
	<xs:include schemaLocation="./planitlibrary.xsd" />
	<xs:import namespace="http://www.opengis.net/gml"
		schemaLocation="http://schemas.opengis.net/gml/3.1.1/base/gml.xsd" />

	<!-- Complex types -->
	<xs:complexType name="linkLengthType">
		<xs:simpleContent>
			<xs:extension base="xs:double">
				<xs:attribute name="unit" type="lengthUnit" default="km" use="optional">
					<xs:annotation>
						<xs:documentation>
							Default length unit is assumed to be kilometres
							(km)
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<!-- Simple types -->

	<xs:simpleType name="vehicularType">
		<xs:annotation>
			<xs:documentation>
				Choice between vehicle and no_vehicle
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="vehicle" />
			<xs:enumeration value="no_vehicle" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="motorisationType">
		<xs:annotation>
			<xs:documentation>
				Choice between motorised and non_motorised
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="motorised" />
			<xs:enumeration value="non_motorised" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="trackType">
		<xs:annotation>
			<xs:documentation>
				Choice between road and rail, e.g. does it refer to a mode that uses rail
				or road
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="road" />
			<xs:enumeration value="rail" />
			<xs:enumeration value="water" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="usedToType">
		<xs:annotation>
			<xs:documentation>
				Choice between private, public, ride_share, and high_occupancy
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="private" />
			<xs:enumeration value="public" />
			<xs:enumeration value="ride_share" />
			<xs:enumeration value="taxi" />
			<xs:enumeration value="emergency" />
			<xs:enumeration value="active" />
			<xs:enumeration value="goods" />
		</xs:restriction>
	</xs:simpleType>

	<!-- simple elements -->
	<xs:element name="maxdensitylane" type="xs:double"
		default="180.0">
		<xs:annotation>
			<xs:documentation>
				Maximum density of a lane in veh/km/lane, default
				set to 180
			</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="pcu" type="xs:double" default="1">
		<xs:annotation>
			<xs:documentation>
				Person car equivalent of a mode
			</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="capacitylane" type="xs:double"
		default="1800.0">
		<xs:annotation>
			<xs:documentation>
				Maximum capacity, i.e., throughput, of a lane in
				pcu/km/lane, default set to 1800
			</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="maxspeed" type="xs:double" default="80.0">
		<xs:annotation>
			<xs:documentation>
				Maximum speed in km/h
			</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="critspeed" type="xs:double">
		<xs:annotation>
			<xs:documentation>
				Speed at capacity, i.e., critical speed of a lane
				in km/h
			</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="numberoflanes" type="xs:positiveInteger"
		default="1">
		<xs:annotation>
			<xs:documentation>
				Number of lanes of a link segment
			</xs:documentation>
		</xs:annotation>
	</xs:element>

	<!-- Complex elements -->
	
  <xs:element name="accessgroup">
    <xs:annotation>
      <xs:documentation>
        Define the link segment types maximum and critical speed for one or more modes.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>     
	    <xs:sequence>
	      <xs:element ref="maxspeed" minOccurs="0" maxOccurs="1" />
	      <xs:element ref="critspeed" minOccurs="0" maxOccurs="1" />
	    </xs:sequence>
	    <xs:attribute name="moderefs" type="xs:string" use="optional">
	      <xs:annotation>
	        <xs:documentation>
	          Refers to the modes this information relates to. If absent all
	          modes available in the network layer will take on the values provided.
	        </xs:documentation>
	      </xs:annotation>
	    </xs:attribute>
    </xs:complexType> 	    
  </xs:element>

	
	<xs:element name="configuration">
		<xs:annotation>
			<xs:documentation>
				Configuration, i.e., meta data of the network
				infrastructure
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="modes" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
							Modes available in this project. Note that when
							this element is absent a single default mode is created to
							represent all modes. If this is the case, no references to modes
							are to be
							made in any forthcoming elements as there is nothing to
							refer
							to, i.e., no ids of modes are present so they cannot be
							referred.
						</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="layerconfiguration">
		<xs:annotation>
			<xs:documentation>
				Configuration, i.e., meta data of a network layer
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="linksegmenttypes" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
							Link segment types define the different types of
							link segment properties that can be attributed to links. Note
							that it is allowed not to define this element. In that case all
							link(segments) are assumed to be of the same default
							link segment type.
						</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="layer">
		<xs:annotation>
			<xs:documentation>
				The physical infrastructure consists of nodes and
				links
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="layerconfiguration" />
				<xs:element ref="nodes" />
				<xs:element ref="links" />
				<xs:element name="turns" type="turnsType" minOccurs="0" maxOccurs="1"/>
				<xs:element name="independentmovements" type="movementsType" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation>
							Optional movements of this layer that belong to no intersection, each spanning more than one
							node and stored only because a ban is placed on it directly
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="intersections" type="intersectionsType" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation>
							Optional intersections of this layer: junctions or crossings, how each is controlled, and
							which link segments enter it and, for a spatial intersection, lie inside it
						</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="id" type="xs:string" use="required" />
			<xs:attribute name="externalid" type="xs:string"
				use="optional" />
			<xs:attribute name="srsname" type="srsname" use="optional" default="EPSG:4326">
				<xs:annotation>
					<xs:documentation>
						Spatial reference system chosen for
						infrastructure, if absent WGS84, i.e., epsg:4326, is assumed
					</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="modes" type="xs:string"
				use="optional">
				<xs:annotation>
					<xs:documentation>
						comma separated list of the modes supported by this layer.
						In case the attribute is absent, it is assumed the layer
						is the only layer available and supports all the modes defined on
						the network.
						TODO: create a type that is able to verify if the string is a comma
						seaprated list
					</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>

	<xs:element name="infrastructurelayers">
		<xs:annotation>
			<xs:documentation>
				The physical infrastructure consists of nodes and
				links
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="layer" minOccurs="1" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>
							each network consists of at least one infrastructure layer containing
							network elements such as nodes, links, etc.
						</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="srsname" type="srsname" use="optional" default="EPSG:4326">
				<xs:annotation>
					<xs:documentation>
						Spatial reference system chosen for
						infrastructure, if absent WGS84, i.e., epsg:4326, is assumed
					</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>

	<xs:element name="linksegmenttype">
		<xs:annotation>
			<xs:documentation>
				a single link segment type with macroscopic model mode specific
				properties
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="name" type="xs:string" default="" />
				<xs:element ref="maxdensitylane" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
							When not present, the default maximum density per lane will be applied
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="capacitylane" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
							When not present, the default capacity per lane will be applied, unless the applied assignment can
							create a more accurate estimate of the capacity based on its fundamental diagram definition and available free speed
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="access" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
							When not present, all modes are assumed to be
							allowed based on their default properties
							(possibly dynamically capped by the physical link properties)
						</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="accessgroup" minOccurs="0" maxOccurs="unbounded" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="id" type="xs:string" use="required" />
			<xs:attribute name="externalid" type="xs:string"
				use="optional" />
		</xs:complexType>
	</xs:element>

	<xs:element name="linksegmenttypes">
		<xs:annotation>
			<xs:documentation>
				The link segment types can be used to group similar
				link characteristics in one place. Each link segment has exactly one
				link segment type associated with it
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="linksegmenttype" maxOccurs="unbounded" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="linksegment">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="numberoflanes" minOccurs="0"
					maxOccurs="1" />
				<xs:element ref="maxspeed" minOccurs="0" maxOccurs="1" />
			</xs:sequence>
			<xs:attribute name="id" type="xs:string" use="required" />
			<xs:attribute name="externalid" type="xs:string"
				use="optional" />
			<xs:attribute name="dir" type="direction" use="required" />
			<xs:attribute name="typeref" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>
						Refers to the unique identifier (id) associated
						with link segment type of this link segment.
						Note that while
						typeref is optional, this is only allowed when no link segment
						types have been defined
						and we can assume it safe to revert to the
						single default link
						segment type that has been created internally.
					</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>

	<xs:element name="links">
		<xs:annotation>
			<xs:documentation>
				The connections between a pair of nodes
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="link" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>
							The connection between a pair of nodes which has
							no transport related information yet. This is purely the graph
							based definition of the structure of some network
						</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="name" type="xs:string" default=""
								minOccurs="0" />
							<xs:element ref="gml:LineString" minOccurs="0"
								maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										Each link segment has an optional gml
										LineString to define shape points. Note that one can choose to
										either duplicate the node points or not here
									</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="custom" minOccurs="0" maxOccurs="1" type="customPropertiesType">
								<xs:annotation>
									<xs:documentation>
										Custom input properties for links are defined here (if any)
									</xs:documentation>
								</xs:annotation>
							</xs:element>
							<!-- a link segment has a direction, at most two directions exist 
								per link -->
							<xs:element ref="linksegment" minOccurs="1"
								maxOccurs="2">
								<xs:annotation>
									<xs:documentation>
										Each link segment has a direction and at most
										two directions exist per link
									</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="length" minOccurs="0" maxOccurs="1"
								type="linkLengthType">
								<xs:annotation>
									<xs:documentation>
										Optional length in km property which
										overrides any geo-spatial length which is deduced from the
										coordinate system
									</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
						<xs:attribute name="id" type="xs:string"
							use="required" />
						<xs:attribute name="externalid" type="xs:string"
							use="optional" />
						<xs:attribute name="nodearef" type="xs:string"
							use="required">
							<xs:annotation>
								<xs:documentation>
									Refers to the unique node identifier (id)
									associated with node 'a' of this link segment
								</xs:documentation>
							</xs:annotation>
						</xs:attribute>
						<xs:attribute name="nodebref" type="xs:string"
							use="required">
							<xs:annotation>
								<xs:documentation>
									Refers to the unique node identifier
									associated with node 'b' of this link segment
								</xs:documentation>
							</xs:annotation>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="physicalfeatures">
		<xs:annotation>
			<xs:documentation>
				Physical features of a mode.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="vehicletype" type="vehicularType"
					default="vehicle">
					<xs:annotation>
						<xs:documentation>
							vehicular type of the mode
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="motorisationtype"
					type="motorisationType" default="motorised">
					<xs:annotation>
						<xs:documentation>
							motorisation type of the mode
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="tracktype" type="trackType"
					default="road">
					<xs:annotation>
						<xs:documentation>
							track type of the mode
						</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="usabilityfeatures">
		<xs:annotation>
			<xs:documentation>
				Usability features of a mode.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="usedtotype" type="usedToType"
					default="private">
					<xs:annotation>
						<xs:documentation>
							how this mode is used
						</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="modes">
		<xs:annotation>
			<xs:documentation>
				The modes of transport used by travelers.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="mode" maxOccurs="unbounded">
					<xs:complexType>
						<xs:annotation>
							<xs:documentation>
								Each mode can have a description(name) and pcu
								value besides their unique identifier (id).
								When no name is given, the description is absent. When no pcu value
								is defined the default is adopted. When a predefined PLANit mode is used
								this is indicated with attribute predefined. For predefined
								modes all features are defined by defaults and therefore
								sub-elements need not be specified, if they are
								they are ignored. When the predefines attribute is missing, it is inferred from
								the name. Note however that if you use a custom mode with a
								predefined name, PLANit will then populate the mode with the
								predefined defaults instead of the specified ones.
							</xs:documentation>
						</xs:annotation>
						<xs:sequence>
							<xs:element name="name" type="xs:string" minOccurs="0"
								maxOccurs="1" />
							<!-- max speed in km/h -->
							<xs:element ref="maxspeed" minOccurs="0" maxOccurs="1" />
							<xs:element ref="pcu" minOccurs="0" />
							<xs:element ref="physicalfeatures" minOccurs="0"
								maxOccurs="1" />
							<xs:element ref="usabilityfeatures" minOccurs="0"
								maxOccurs="1" />
						</xs:sequence>
						<xs:attribute name="id" type="xs:string"
							use="required" />
						<xs:attribute name="externalid" type="xs:string"
							use="optional" />
						<xs:attribute name="predefined" type="xs:boolean"
							use="optional" default="false" />
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="nodes">
		<xs:annotation>
			<xs:documentation>
				Nodes represent the locations where links (roads)
				intersect and traffic interacts with each other.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="node" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="name" type="xs:string" minOccurs="0"
								maxOccurs="1" />
							<xs:element ref="gml:Point" minOccurs="0"
								maxOccurs="1">
								<xs:annotation>
									<xs:documentation>
										Each node should have a location via a
										gml:Point definition based on the gml xsd schema
									</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="custom" minOccurs="0" maxOccurs="1" type="customPropertiesType">
								<xs:annotation>
									<xs:documentation>
										Custom input properties for nodes are defined here (if any)
									</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
						<xs:attribute name="id" type="xs:string"
							use="required" />
						<xs:attribute name="externalid" type="xs:string"
							use="optional" />
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<!-- Definition of the 'ban' element -->
	<xs:complexType name="banType">
		<xs:attribute name="id" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>Mandatory unique identifier for the turn ban.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="externalid" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>Optional identifier for cross-referencing with external databases.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="fromlsref" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>Id of the link segment of this layer the banned turn starts on.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="tolsref" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>Id of the link segment of this layer the banned turn goes onto.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="moderefs" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>
					Comma-separated list of the ids of the modes the turn is banned for. When left out, the turn is
					banned for every mode
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- Definition of the 'turns' element -->
	<xs:complexType name="turnsType">
		<xs:sequence>
			<xs:element name="ban" type="banType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<!-- Simple types of the 'intersection' element -->
	<xs:simpleType name="intersectionControlType">
		<xs:annotation>
			<xs:documentation>
				How traffic at an intersection is controlled: signalised (traffic signals) or unsignalised
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="signalised" />
			<xs:enumeration value="unsignalised" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="intersectionTypeType">
		<xs:annotation>
			<xs:documentation>
				Kind of intersection the control applies to: road traffic meeting at a junction, or a pedestrian
				crossing
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="junction" />
			<xs:enumeration value="crossing" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="intersectionTypeListType">
		<xs:annotation>
			<xs:documentation>
				Space-separated list of one or more intersection kinds, e.g. "junction crossing"
			</xs:documentation>
		</xs:annotation>
		<xs:restriction>
			<xs:simpleType>
				<xs:list itemType="intersectionTypeType" />
			</xs:simpleType>
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>

	<!-- Definition of the 'approach' element of an intersection -->
	<xs:complexType name="intersectionApproachType">
		<xs:attribute name="ref" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>Id of the link segment of this layer that enters the intersection.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="signal" type="xs:boolean" use="optional">
			<xs:annotation>
				<xs:documentation>
					Whether the approach has a signal of its own. When left out, the approach follows the control of
					the intersection, so it is only written where it differs: false at a signalised intersection, true
					at an unsignalised one
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- Definition of the 'approaches' element of an intersection -->
	<xs:complexType name="intersectionApproachesType">
		<xs:sequence>
			<xs:element name="approach" type="intersectionApproachType" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A link segment entering the intersection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!-- Definition of the 'internalsegments' element of an intersection -->
	<xs:complexType name="intersectionInternalSegmentsType">
		<xs:attribute name="refs" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>
					Comma-separated list of the ids of the link segments of this layer inside the intersection that
					have no signal standing on them
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- Definition of the 'internalsignalsegment' element of an intersection -->
	<xs:complexType name="intersectionInternalSignalSegmentType">
		<xs:attribute name="ref" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>
					Id of a link segment of this layer inside the intersection with a signal standing on it, such as a
					stop line in a median
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- Definition of the 'internalsignalsegments' element of an intersection -->
	<xs:complexType name="intersectionInternalSignalSegmentsType">
		<xs:sequence>
			<xs:element name="internalsignalsegment" type="intersectionInternalSignalSegmentType" minOccurs="1"
				maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A link segment inside the intersection with a signal standing on it.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!-- Definition of the 'movement' element, of a spatial intersection or independent -->
	<xs:complexType name="movementType">
		<xs:annotation>
			<xs:documentation>
				A movement from one link segment to another. Only a ban placed on the movement itself is written: a
				movement without one can still be blocked by a banned turn at a member node of its intersection, or by
				mode access
			</xs:documentation>
		</xs:annotation>
		<xs:attribute name="id" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>Mandatory unique identifier for the movement.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="externalid" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>Optional identifier for cross-referencing with external databases.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="fromlsref" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>
					Id of the link segment the movement starts on; for a movement of a spatial intersection one of its
					approaches
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="tolsref" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>
					Id of the link segment the movement ends on; for a movement of a spatial intersection one leaving it
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="length" type="xs:double" use="required">
			<xs:annotation>
				<xs:documentation>
					Length of the movement, from where its from segment ends to where its to segment starts, in km
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="directban" type="xs:boolean" use="optional">
			<xs:annotation>
				<xs:documentation>
					True when a ban is placed on the movement itself. Left out, there is none, unless bannedmoderefs is
					given, which implies one
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="bannedmoderefs" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>
					Comma-separated list of the ids of the modes the direct ban is for. When left out, a direct ban is
					for every mode
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- Definition of the 'movements' element, of a spatial intersection or of the independent movements of a layer -->
	<xs:complexType name="movementsType">
		<xs:sequence>
			<xs:element name="movement" type="movementType" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A movement from one link segment to another.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!-- What both kinds of intersection have; each kind extends it. The id and externalid are declared by each kind, so
	     they are written first: an element's own attributes are written before those of its base type -->
	<xs:complexType name="intersectionBaseType" abstract="true">
		<xs:sequence>
			<xs:element name="approaches" type="intersectionApproachesType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The link segments entering the intersection. An intersection may have none.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="control" type="intersectionControlType" use="required">
			<xs:annotation>
				<xs:documentation>How traffic at the intersection is controlled.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="types" type="intersectionTypeListType" use="required">
			<xs:annotation>
				<xs:documentation>
					Space-separated list of the kinds of the intersection, at least one, e.g. "junction crossing"
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- Definition of the 'intersection' element: a non-spatial intersection, on one node -->
	<xs:complexType name="intersectionType">
		<xs:complexContent>
			<xs:extension base="intersectionBaseType">
				<xs:attribute name="id" type="xs:string" use="required">
					<xs:annotation>
						<xs:documentation>
							Mandatory unique identifier for the intersection, unique over both kinds of intersection.
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="externalid" type="xs:string" use="optional">
					<xs:annotation>
						<xs:documentation>Optional identifier for cross-referencing with external databases.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="noderef" type="xs:string" use="required">
					<xs:annotation>
						<xs:documentation>
							Id of the node of this layer the intersection is on. A node belongs to at most one intersection
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- Definition of the 'spatialintersection' element: an intersection over several nodes -->
	<xs:complexType name="spatialIntersectionType">
		<xs:complexContent>
			<xs:extension base="intersectionBaseType">
				<xs:sequence>
					<xs:element name="internalsegments" type="intersectionInternalSegmentsType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>
								The link segments inside the intersection without a signal. Each internal segment is listed
								either here or under internalsignalsegments, not both
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="internalsignalsegments" type="intersectionInternalSignalSegmentsType" minOccurs="0"
						maxOccurs="1">
						<xs:annotation>
							<xs:documentation>The link segments inside the intersection with a signal standing on them.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="movements" type="movementsType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>
								Every movement through the intersection: one for each approach and link segment leaving it that
								its internal segments connect, banned or not, except the one back along the approach's own link
							</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="id" type="xs:string" use="required">
					<xs:annotation>
						<xs:documentation>
							Mandatory unique identifier for the intersection, unique over both kinds of intersection.
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="externalid" type="xs:string" use="optional">
					<xs:annotation>
						<xs:documentation>Optional identifier for cross-referencing with external databases.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="noderefs" type="xs:string" use="required">
					<xs:annotation>
						<xs:documentation>
							Comma-separated list of the ids of the two or more nodes of this layer forming the intersection. A
							node belongs to at most one intersection
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- Definition of the 'intersections' element -->
	<xs:complexType name="intersectionsType">
		<xs:sequence>
			<xs:element name="intersection" type="intersectionType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
						A non-spatial intersection of this layer, on one node. Every turn at its node is allowed unless
						banned, see the turns of the layer
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="spatialintersection" type="spatialIntersectionType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A spatial intersection of this layer, over several nodes.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!-- Root element -->
	<xs:element name="macroscopicnetwork">
		<xs:annotation>
			<xs:documentation>
				Root element of the macroscopic network
				infrastructure. Defines the physical road network and its properties
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
        <xs:element name="id" type="xs:string" minOccurs="1" />			
				<xs:element ref="configuration" minOccurs="0">				
					<xs:annotation>
						<xs:documentation>
							When configuration is absent we assume a single
							mode for the entire simulation
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="infrastructurelayers" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

</xs:schema>