<?xml version="1.0" encoding="ISO-8859-1"?>
<macroscopicnetwork
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xmlns:gml="http://www.opengis.net/gml"                     
   xmlns="http://goplanit.org/v1" xsi:schemaLocation="http://goplanit.org/v1 ../../xsd/v1/macroscopicnetworkinput.xsd">
  <id>1</id>
  <configuration>
    <!-- the available modes are on the top level configuration of the network -->                                   
    <modes>                                     
      <mode id="car">
        <name>car</name>                            
        <pcu>1</pcu>                                        
      </mode>                   
      <mode id="bus">
        <name>bus</name>
        <pcu>2</pcu>
      </mode>
      <mode id="train">
        <name>train</name>
        <pcu>6</pcu>
      </mode>
    </modes>        
  </configuration>
  <infrastructurelayers srsname="EPSG:4326">
    <!-- a layer supports a subset of modes, each of which can only occur on one layer each  -->
    <layer id="roadlayer" externalid="someid" modes="car,bus">
      <!-- each layer has its own configuration, in case of a macroscopic network these contain the link segment types -->
      <layerconfiguration>
          <linksegmenttypes>                                
			      <linksegmenttype id="1">                          
			        <name>local road</name>                         
			        <maxdensitylane>180</maxdensitylane>                  
			        <capacitylane>2000</capacitylane>                   
			        <access>
			          <accessgroup moderefs="car,bus">
			            <maxspeed>40</maxspeed>                     
			            <critspeed>35</critspeed>                   
			          </accessgroup>
			        </access>
			      </linksegmenttype>
			    </linksegmenttypes> 
      </layerconfiguration>
      <!-- ids of nodes, links, still need to be unique across layers to make sure outputs can easily be identified, internal ids
           might not be unique across all layers, depending on how it is configured, but should be unique within the context (layer).
           the user however should not be aware of this -->
	    <nodes>
	      <node id="1">                                 
	        <name>George Street roundabout</name>
	        <gml:Point>
	          <gml:pos>150.512796 -34.900145</gml:pos>
	        </gml:Point>                            
	      </node>
	      <node id="2"> 
	        <name>Broadway intersection</name>
	        <gml:Point>
	          <gml:pos>150.512527 -34.900319</gml:pos>
	        </gml:Point>          
	      </node>       
	    </nodes>    
	    <links>
	      <link id="1" nodearef="1" nodebref="2">             
	        <name>Broadway</name>                       
	        <gml:LineString>                  
	          <gml:coordinates cs=" " ts=",">100,200 150,300</gml:coordinates>
	        </gml:LineString> 
	        <linksegment id="1" dir="a_b" typeref="1">  
	          <numberoflanes>2</numberoflanes>      
	          <maxspeed>50</maxspeed>                       
	        </linksegment>
	        <linksegment id="2" dir="b_a" typeref="1">
	          <numberoflanes>1</numberoflanes>
	          <maxspeed>50</maxspeed>
	        </linksegment>          
	        <length unit="km">1.33</length>                 
	      </link>
	    </links>
	    
    </layer>            
    <layer id="railnetwork" modes="train">
      <layerconfiguration>
        <linksegmenttypes>
          <linksegmenttype id="2">
            <name>track</name>
            <maxdensitylane>20</maxdensitylane>
            <capacitylane>100</capacitylane>
            <access>
              <accessgroup moderefs="train">
                <maxspeed>100</maxspeed>
              </accessgroup>
            </access>
          </linksegmenttype>
        </linksegmenttypes>
      </layerconfiguration>
      <nodes>
        <node id="3">
          <name>Central</name>
        </node>
        <node id="4">
          <name>Redfern</name>
        </node>
      </nodes>
      <links>
        <link id="2" nodearef="3" nodebref="4">
          <linksegment id="3" dir="a_b" typeref="2"/>
          <linksegment id="4" dir="b_a" typeref="2"/>
          <length unit="km">1.2</length>
        </link>
      </links>
    </layer>             
  </infrastructurelayers>
</macroscopicnetwork>
